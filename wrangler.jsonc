
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "fgo-checkin-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-25",

  "durable_objects": {
    "bindings": [
      {
        "name": "FGO_SCHEDULER",
        "class_name": "FgoScheduler"
      }
    ]
  },

  "exports": {
    "FgoScheduler": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
